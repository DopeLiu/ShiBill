<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 通知权限（API 33+ 运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 唯一联网点：检查更新（GitHub Releases） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      注：不使用前台服务（Foreground Service）。
      API 34+ 前台服务类型清单中不存在 accessibility 类型，且无障碍服务本身即为
      系统绑定服务（生命周期由系统托管），"记一笔"入口通过常驻 ongoing 通知实现。
    -->


    <application
        android:name=".ShiBillApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShiBill">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ShiBill">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 主通道：通知监听 -->
        <service
            android:name=".capture.BillNotificationListenerService"
            android:exported="false"
            android:label="拾账-通知监听"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 兜底通道：无障碍截屏（API 30+，默认关闭） -->
        <service
            android:name=".capture.BillAccessibilityService"
            android:exported="false"
            android:label="拾账-截屏识别"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 「记一笔」截屏按钮 → 触发无障碍服务截屏 -->
        <receiver
            android:name=".capture.ScreenshotTriggerReceiver"
            android:exported="false" />

    </application>

</manifest>
